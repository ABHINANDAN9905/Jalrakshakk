# ==========================================
# JalRakshak Frontend Environment Blueprint
# ==========================================

# Application Metadata
VITE_APP_NAME="JalRakshak"
VITE_APP_TAGLINE="AI-Powered Groundwater Intelligence & Simulation Platform"

# Backend API Endpoint
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# WebSocket Server Endpoint for Real-time Simulation
VITE_SOCKET_URL="http://localhost:5000"

# Simulation Engine Client Defaults
VITE_DEFAULT_TICK_RATE_MS=2000
VITE_ENABLE_DEBUG_OVERLAY=true
VITE_ENABLE_ANALYTICS=false
