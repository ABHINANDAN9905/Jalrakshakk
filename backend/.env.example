# ==========================================
# JalRakshak Backend Environment Blueprint
# ==========================================

# Server Execution Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Primary Relational Store (PostgreSQL with Prisma - Phase 3)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/jalrakshak?schema=public"

# Document & Telemetry Store (MongoDB with Mongoose - Phase 3)
MONGODB_URI="mongodb://localhost:27017/jalrakshak"

# Authentication & Cryptographic Security (Phase 5)
JWT_SECRET=super_secret_jwt_access_key_jalrakshak_dev_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_jalrakshak_dev_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# AI Water Mentor Integration (OpenAI API - Later Phase)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_MENTOR_MAX_TOKENS=800

# Rate Limiting & Safety Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging & Telemetry Level (error, warn, info, http, debug)
LOG_LEVEL=debug
